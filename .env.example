# Sao chép file này thành .env rồi điền giá trị thật

# Database. Mặc định SQLite (file prisma/dev.db).
# PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/mogiftbox" (nhớ đổi provider trong prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Domain chính thức – dùng cho SEO, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chuỗi bí mật ký cookie (phiên admin, quyền xem đơn). Bắt buộc khi chạy production.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Tài khoản quản trị: `npm run db:seed` tạo tài khoản này với quyền admin.
# Đăng nhập ở /dang-nhap như khách, rồi vào /admin. Mật khẩu ít nhất 8 ký tự, có chữ và số (nên dài 16+ ký tự).
# Đặt lại mật khẩu bất cứ lúc nào: npm run admin:create -- email@cua-ban.vn MatKhauMoi123
ADMIN_EMAIL="admin@mogiftbox.vn"
ADMIN_PASSWORD="doi-mat-khau-nay-1"

# Thư mục lưu ảnh admin tải lên (mặc định ./uploads). Trên Railway trỏ vào volume, ví dụ /data/uploads
# UPLOAD_DIR=/data/uploads
